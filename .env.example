# Copy this file to .env and fill in real values before running.

# SQLite file used by Prisma (fine for prototype/dev use).
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# VAPID keys for Web Push notifications. Generate with:
#   npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Base URL of this app (used to build absolute check-in URLs inside QR codes).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
